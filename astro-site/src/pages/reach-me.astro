---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Samuel Berlad | Contact"
    description="Samuel Berlad - Professional Bass-Baritone. Contact information and virtual business card."
    canonicalPath="/reach-me.html"
    ogType="profile"
    ogTitle="Contact | Samuel Berlad Bass-Baritone"
    ogDescription="Get in touch with professional bass-baritone Samuel Berlad. Based in Germany and Israel. Available for opera, concerts, and vocal instruction."
    pageScript="/js/pages/reach-me.js"
>
    <Fragment slot="page-css">
        <link rel="stylesheet" href="/css/pages/reach-me.css">
    </Fragment>

    <Fragment slot="head-extra">
        <!-- CONTACT PAGE SCHEMA (reach-me.html) -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ContactPage",
            "name": "Contact Samuel Berlad",
            "description": "Professional contact information for bass-baritone Samuel Berlad",
            "mainEntity": {
                "@type": "Person",
                "name": "Samuel Berlad",
                "jobTitle": "Professional Bass-Baritone Opera Singer",
                "contactPoint": [
                    {
                        "@type": "ContactPoint",
                        "email": "contact@samuelberlad.com",
                        "contactType": "Professional Booking",
                        "availableLanguage": ["English", "German", "Hebrew"]
                    }
                ],
                "areaServed": ["Europe", "Israel", "Germany"],
                "serviceType": ["Opera Performance", "Concert Performance", "Vocal Instruction"]
            }
        })} />
    </Fragment>

    <!-- Main Content -->
    <main class="container" id="main-content">
    <div class="page-header">
    <h1 class="page-title">Contact</h1>
    <p class="page-subtitle">Professional Bass-Baritone • Germany • Israel</p>
    </div>

    <!-- Virtual Business Card -->
    <div class="business-card">
        <div class="card-photo">
            <img src="/images/contact-portrait.jpg" width="480" height="480" alt="Samuel Berlad" id="contactPortrait">
        </div>

        <h2 class="card-name">Samuel Berlad</h2>
        <p class="card-title">Bass-Baritone</p>
        <p class="card-specialties">Opera • Concert • Chazzan • Vocal Pedagogue</p>

        <!-- Save to Contacts Button -->
        <button class="save-contact" id="saveContactBtn">
            <i class="fas fa-download"></i>
            Save to Contacts
        </button>

        <!-- Quick Contact Actions -->
        <div class="contact-actions">
        <a href="mailto:contact@samuelberlad.com" class="contact-btn">
            <i class="fas fa-envelope"></i>
            Email
        </a>
        <a href="https://wa.me/4917662566823" class="contact-btn" target="_blank">
            <i class="fab fa-whatsapp"></i>
            WhatsApp
        </a>
        <a href="tel:+49-176-62566823" class="contact-btn">
            <i class="fas fa-phone"></i>
            Germany
        </a>
        <a href="tel:+972-53-429-6543" class="contact-btn">
            <i class="fas fa-phone"></i>
            Israel
        </a>
        </div>

        <!-- Contact Info Grid -->
        <div class="contact-info-grid">
        <div class="contact-info-item">
            <h4>Email</h4>
            <p>contact@samuelberlad.com</p>
        </div>
        <div class="contact-info-item">
            <h4>Based in</h4>
            <p>Germany • Israel</p>
        </div>
        <div class="contact-info-item">
            <h4>Phone Germany</h4>
            <p>+49-(0)176-62566823</p>
        </div>
        <div class="contact-info-item">
            <h4>Phone Israel</h4>
            <p>+972-(0)53-429-6543</p>
        </div>
        <div class="contact-info-item">
            <h4>Languages</h4>
            <p>German, English, Hebrew, French, Italian</p>
        </div>
        <div class="contact-info-item">
            <h4>Specializations</h4>
            <p>Opera, Concert, Chazzan, Vocal Pedagogue (Dipl. IGP)</p>
        </div>
    </div>

    <!-- Social Links -->
    <div class="card-social-links">
    <a href="https://www.facebook.com/samuel.berlad/" target="_blank" class="social-link" aria-label="Facebook">
        <i class="fab fa-facebook"></i>
    </a>
    <a href="https://www.instagram.com/samuelberlad_bassbaritone/" target="_blank" class="social-link" aria-label="Instagram">
        <i class="fab fa-instagram"></i>
    </a>
    <a href="https://www.youtube.com/channel/UC5I1E7F3C1SUcLed-w7Ax9A" target="_blank" class="social-link" aria-label="YouTube">
        <i class="fab fa-youtube"></i>
    </a>
    <a href="https://open.spotify.com/artist/6yueNB4pXtAZmGPh01Q4Eo" target="_blank" class="social-link" aria-label="Spotify">
        <i class="fab fa-spotify"></i>
    </a>
    </div>
    </div>

    <!-- QR Code Section -->
    <div class="qr-section">
    <h3>Share My Contact</h3>
    <div class="qr-code">
    <img src="/images/qr-code.png" width="1148" height="1148" alt="QR Code - Samuel Berlad Contact">
    </div>
    <p style="color: var(--light-gray); font-size: 0.9rem;">
    Scan to share my contact information
    </p>
    </div>
    </main>
</BaseLayout>
