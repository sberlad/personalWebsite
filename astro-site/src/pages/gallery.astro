---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Samuel Berlad | Gallery"
    description="Samuel Berlad performance gallery - Stage photos from opera and concert performances across Europe and Israel."
    canonicalPath="/gallery.html"
    ogTitle="Performance Gallery | Samuel Berlad"
    ogDescription="Stage photos from opera and concert performances across Europe and Israel. See Samuel Berlad in action on stage."
    ogImage="https://samuelberlad.com/images/gallery/rheingold1.jpg"
    pageScript="/js/pages/gallery.js"
>
    <Fragment slot="page-css">
        <link rel="stylesheet" href="/css/pages/gallery.css">
    </Fragment>

    <Fragment slot="head-extra">
        <!-- GALLERY PAGE SCHEMA (gallery.html) -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ImageGallery",
            "name": "Performance Gallery - Samuel Berlad",
            "description": "Professional stage photography from Samuel Berlad's opera and concert performances",
            "creator": { "@type": "Person", "name": "Samuel Berlad" },
            "about": {
                "@type": "Person",
                "name": "Samuel Berlad",
                "jobTitle": "Bass-Baritone Opera Singer"
            }
        })} />
    </Fragment>

    <!-- Main Content -->
    <main class="gallery-container" id="main-content">
        <div class="gallery-header">
            <h1 class="gallery-title">Gallery</h1>
        </div>

        <!-- Filters -->
        <div class="gallery-filters">
            <select class="gallery-filter-select" id="yearFilter" aria-label="Filter by year">
                <option value="all">All Years</option>
            </select>
            <select class="gallery-filter-select" id="venueFilter" aria-label="Filter by institution">
                <option value="all">All Institutions</option>
            </select>
            <select class="gallery-filter-select" id="genreFilter" aria-label="Filter by genre">
                <option value="all">All Genres</option>
            </select>
        </div>

        <!-- Productions (grid of tiles, each opening a lightbox of that production's photos) -->
        <div class="production-grid" id="productionGrid">
            <!-- Loaded from gallery-photos.json -->
        </div>

        <!-- No Results -->
        <div class="gallery-no-results" id="galleryNoResults" hidden>
            No productions match these filters.
        </div>

        <!-- Lightbox -->
        <div class="lightbox" id="lightbox" hidden>
            <button class="lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
            <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous photo">
                <i class="fas fa-chevron-left"></i>
            </button>
            <div class="lightbox-content">
                <img id="lightboxImage" src="" alt="">
                <div class="lightbox-info">
                    <div class="lightbox-description" id="lightboxDescription"></div>
                    <div class="lightbox-credit" id="lightboxCredit"></div>
                    <div class="lightbox-count" id="lightboxCount"></div>
                </div>
            </div>
            <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next photo">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

    </main>
</BaseLayout>
